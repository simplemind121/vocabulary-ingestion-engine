POSTGRES_DB=vie
POSTGRES_USER=vie
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+psycopg://vie:replace-with-a-long-random-password@postgres:5432/vie
VIE_API_KEY=replace-with-a-long-random-api-token
VIE_OCR_ENGINE=tesseract
VIE_OCR_LANGUAGES=eng+chi_sim
VIE_MAX_UPLOAD_BYTES=536870912
VIE_MAX_PDF_PAGES=5000
VIE_MAX_RENDER_PIXELS_PER_PAGE=40000000

S3_ACCESS_KEY_ID=replace-with-a-random-access-key
S3_SECRET_ACCESS_KEY=replace-with-a-long-random-secret
S3_BUCKET=vie-artifacts
S3_REGION=us-east-1

API_BIND_ADDRESS=127.0.0.1
API_PORT=8000
