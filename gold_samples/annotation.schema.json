{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vie.local/schemas/gold-sample-annotation-v1.json",
  "title": "Vocabulary Ingestion Engine Gold Sample Annotation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["annotation_schema_version", "sample_id", "document_sha256", "page_number", "layout_tags", "review_status", "reviewer_id", "page_image_sha256", "blocks", "entries", "vocabulary", "review_notes"],
  "properties": {
    "annotation_schema_version": {"const": "1.0"},
    "sample_id": {"type": "string", "minLength": 1},
    "document_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "page_number": {"type": "integer", "minimum": 1},
    "layout_tags": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "review_status": {"enum": ["DRAFT", "HUMAN_VERIFIED"]},
    "reviewer_id": {"type": ["string", "null"]},
    "page_image_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "blocks": {"type": "array", "items": {"type": "object"}},
    "entries": {"type": "array", "items": {"type": "object"}},
    "vocabulary": {"type": "array", "items": {"type": "object"}},
    "review_notes": {"type": "array", "items": {"type": "string"}}
  },
  "allOf": [
    {
      "if": {"properties": {"review_status": {"const": "HUMAN_VERIFIED"}}},
      "then": {
        "properties": {
          "reviewer_id": {"type": "string", "minLength": 1},
          "page_image_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "blocks": {"minItems": 1},
          "entries": {"minItems": 1},
          "vocabulary": {"minItems": 1}
        }
      }
    }
  ]
}
