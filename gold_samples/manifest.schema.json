{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vocabulary-ingestion-engine.local/schemas/gold-sample-manifest-v1.json",
  "title": "Vocabulary Ingestion Engine Gold Sample Dataset v1 Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["dataset_version", "pages"],
  "properties": {
    "dataset_version": {"const": "1.0"},
    "pages": {
      "type": "array",
      "minItems": 30,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sample_id",
          "document_sha256",
          "page_number",
          "page_image_sha256",
          "layout_tags",
          "ground_truth_path",
          "review_status",
          "reviewer_id",
          "annotation_schema_version"
        ],
        "properties": {
          "sample_id": {"type": "string", "minLength": 1},
          "document_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "page_number": {"type": "integer", "minimum": 1},
          "page_image_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "layout_tags": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "NORMAL",
                "DOUBLE_COLUMN",
                "IPA_DENSE",
                "IMAGE",
                "SPECIAL_LAYOUT",
                "BOUNDARY_ENTRY",
                "CROSS_PAGE_ENTRY",
                "TABLE",
                "INDEX",
                "OCR_HARD"
              ]
            }
          },
          "ground_truth_path": {"type": "string", "minLength": 1},
          "review_status": {"const": "HUMAN_VERIFIED"},
          "reviewer_id": {"type": "string", "minLength": 1},
          "annotation_schema_version": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
